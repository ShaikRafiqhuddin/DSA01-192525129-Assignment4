digraph {
  rankdir=LR; bgcolor="white"; pad=0.15; nodesep=0.3; ranksep=0.55;
  node [fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  ptr [shape=box, style="filled", fillcolor="#EEF3FA", color="#1F3864", label="Account* a"];
  obj [shape=record, style="filled", fillcolor="#EEF3FA", color="#1F3864", label="{SeniorAccount object|Account part (rate)\ldouble* history}"];
  hist [shape=box, style="filled", fillcolor="#FBEDED", color="#8B1A1A", fontcolor="#8B1A1A", label="double[100] on the heap\l800 bytes - NEVER FREED"];
  ptr -> obj [color="#1F3864"];
  obj -> hist [color="#8B1A1A", label="new double[100]"];
  note1 [shape=note, style="filled", fillcolor="#FDF3D8", color="#8a6d1a", fontcolor="#8a6d1a", label="delete a calls only ~Account()\l(destructor not virtual)\l~SeniorAccount() never runs\lso delete[] history never happens\l"];
  obj -> note1 [style=dashed, color="#8a6d1a", arrowhead=none];
}
