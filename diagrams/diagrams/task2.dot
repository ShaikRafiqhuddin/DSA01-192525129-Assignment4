digraph T2 {
  rankdir=TB; bgcolor="white";
  node [shape=record, fontname="Helvetica", fontsize=11, style=filled, fillcolor="#f4f8ff"];
  edge [arrowhead=empty, arrowtail=empty, dir=back];
  Person [label="{Person|# name: string\l# id: int\l# phone: string\l|+ showPerson()\l}"];
  Student [label="{Student|# programme: string\l# cgpa: double\l}"];
  Staff [label="{Staff|# department: string\l# salary: double\l}"];
  TA [label="{TeachingAssistant|+ show()\l}"];
  RS [label="{ResearchScholar|- fellowship: string\l|+ show()\l}"];
  Person -> Student [label="virtual"]; Person -> Staff [label="virtual"];
  Student -> TA; Staff -> TA; Student -> RS;
}
