digraph {
  bgcolor="white"; pad=0.15; nodesep=0.3; ranksep=0.45;
  node [fontname="DejaVu Sans", fontsize=11];
  subgraph cluster_no {
    label="WITHOUT virtual - two Person subobjects"; labelloc=b; fontsize=12; fontname="DejaVu Sans"; fontcolor="#8B1A1A";
    style="rounded"; color="#C46A6A";
    node [shape=box, style="filled", fillcolor="#FBEDED", color="#C46A6A", fontcolor="#3B3B3B"];
    TA1 [label="TeachingAssistant object", fillcolor="#F6DEDE"];
    PS1 [label="Person (via Student)\lname, id, phone"];
    PS2 [label="Person (via Staff)\lname, id, phone"];
    TA1 -> PS1 [color="#C46A6A"];
    TA1 -> PS2 [color="#C46A6A"];
    amb [shape=note, label="ta.name is AMBIGUOUS -\lwhich copy?\l", fillcolor="#F6DEDE", color="#8B1A1A", fontcolor="#8B1A1A", style="filled"];
  }
  subgraph cluster_yes {
    label="WITH virtual - one shared Person subobject"; labelloc=b; fontsize=12; fontname="DejaVu Sans"; fontcolor="#1F6E43";
    style="rounded"; color="#1F6E43";
    node [shape=box, style="filled", fillcolor="#EAF4EC", color="#1F6E43", fontcolor="#3B3B3B"];
    TA2 [label="TeachingAssistant object", fillcolor="#D8EBDD"];
    SH [label="shared Person\lname, id, phone"];
    TA2 -> SH [color="#1F6E43", label="Student path", fontname="DejaVu Sans", fontsize=10];
    TA2 -> SH [color="#1F6E43", label="Staff path", fontname="DejaVu Sans", fontsize=10];
    ok [shape=note, label="one name, one id -\lta.showPerson() works\l", fillcolor="#D8EBDD", color="#1F6E43", fontcolor="#1F6E43", style="filled"];
  }
  TA1 -> TA2 [style=invis];
}
